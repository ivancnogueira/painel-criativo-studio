# Configuração do Painel Administrativo & Hub Central de Licenças
# Subdomínio sugerido: painel.criativoaistudio.com.br
PORT=port
HOST=host
PAINEL_PUBLIC_URL=sua_url

# Login e Senha para acessar o Painel Web (/login)
ADMIN_EMAIL=[SEU_EMAIL_ADMIN]
ADMIN_PASSWORD=[DEFINA_UMA_SENHA_FORTE]
SESSION_SECRET=[GERE_UM_SEGREDO_HEX_64_CHARS]

# Token secreto para chamadas de API administrativas / automações externas
CRIATIVO_ADMIN_TOKEN=[DEFINIR_TOKEN_ADMIN_SEGURO]

# Chave mestra AES-256-GCM para cifrar tokens SMTP/WhatsApp/Checkouts no SQLite
PAINEL_VAULT_KEY=[GERE_UMA_CHAVE_HEX_64_CHARS]

# Par de chaves Ed25519 (a chave pública correspondente fica embarcada no app desktop)
CRIATIVO_LICENSE_PUBLIC_KEY_PEM=""
CRIATIVO_LICENSE_PRIVATE_KEY_PEM=""

# Fallbacks opcionais (também podem ser configurados direto pela UI do Painel)
HOTMART_HOTTOK=
KIWIFY_WEBHOOK_TOKEN=
TICTO_WEBHOOK_TOKEN=
STRIPE_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=
WHATSAPP_PROVIDER=none

# Grupo de Suporte (opcional — também configurável pelo painel em Entregas)
SUPPORT_GROUP_URL=
SUPPORT_GROUP_LABEL=
